{
  "name": "@testfly/playwright",
  "version": "0.2.0-next.0",
  "description": "Zero-boilerplate, batteries-included Playwright framework: BDD, typed YAML locators, self-healing, API/DB/mail fixtures and stability analytics.",
  "license": "Apache-2.0",
  "author": "Hakan G\u00fcl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hakanngul/testfly-playwright.git"
  },
  "homepage": "https://testfly.dev",
  "bugs": {
    "url": "https://github.com/hakanngul/testfly-playwright/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./bdd": {
      "import": {
        "types": "./dist/bdd.d.mts",
        "default": "./dist/bdd.mjs"
      },
      "require": {
        "types": "./dist/bdd.d.ts",
        "default": "./dist/bdd.js"
      }
    },
    "./config": {
      "import": {
        "types": "./dist/config.d.mts",
        "default": "./dist/config.mjs"
      },
      "require": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.js"
      }
    },
    "./locators": {
      "import": {
        "types": "./dist/locators.d.mts",
        "default": "./dist/locators.mjs"
      },
      "require": {
        "types": "./dist/locators.d.ts",
        "default": "./dist/locators.js"
      }
    },
    "./db": {
      "import": {
        "types": "./dist/db.d.mts",
        "default": "./dist/db.mjs"
      },
      "require": {
        "types": "./dist/db.d.ts",
        "default": "./dist/db.js"
      }
    },
    "./mail": {
      "import": {
        "types": "./dist/mail.d.mts",
        "default": "./dist/mail.mjs"
      },
      "require": {
        "types": "./dist/mail.d.ts",
        "default": "./dist/mail.js"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "testfly": "./bin/testfly.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "playwright",
    "bdd",
    "cucumber",
    "testing",
    "e2e",
    "self-healing",
    "test-automation",
    "testfly"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:package": "publint && attw --pack . --profile node16"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@testfly/reporter": "workspace:*",
    "commander": "^14.0.0",
    "playwright-bdd": "^9.2.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50.0 <2",
    "pg": "^8.0.0",
    "mysql2": "^3.0.0",
    "ioredis": "^5.0.0 || ^6.0.0",
    "imapflow": "^1.0.0 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "imapflow": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.4"
  }
}