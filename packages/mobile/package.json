{
  "name": "@testfly/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Experimental mobile helpers for TestFly (device detection, driver-agnostic screen/locator API). Not published.",
  "license": "Apache-2.0",
  "author": "Hakan Gül",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hakanngul/testfly-playwright.git"
  },
  "homepage": "https://testfly.dev",
  "bugs": {
    "url": "https://github.com/hakanngul/testfly-playwright/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "playwright",
    "mobile",
    "ios",
    "android",
    "testfly"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:package": "publint && attw --pack . --profile node16"
  },
  "peerDependencies": {
    "@testfly/playwright": "workspace:^"
  },
  "devDependencies": {
    "@testfly/playwright": "workspace:*",
    "@types/node": "^22.10.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.4"
  }
}
