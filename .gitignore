# Dependencies
node_modules/
.pnp
.pnp.js

# Build Outputs & Bundles
dist/
build/
out/
.tsup/

# TestFly & Playwright Test Results & Reports
reports/
.features-gen/
allure-results/
allure-report/
playwright-report/
cucumber-report/
test-results/
.playwright/
blob-report/
coverage/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# OS / System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Configs
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# Temporary / Cache
.cache/
.temp/
.tmp/
.turbo/

# TestFly local state (history is generated; caches under .testfly/ are meant to be committed)
.testfly/history/
.testfly/report/
# Generated by packages/ai e2e tests (history, reports, heal caches)
packages/ai/test/e2e-project/.testfly/
# Playwright auth storage state written by setup projects (may contain session tokens)
.testfly/sessions/

# Monorepo build outputs / test artifacts (explicit, in addition to the generic rules above)
packages/*/dist/
**/test-results/
